# Copy to .env (not committed) with ./setup.sh, which also fills the
# passwords. Variables left commented out keep the images' defaults.

# Configuration and storage of the containers, regenerated at each start.
CONFIG=~/.jitsi-media-tools-cfg

HTTP_PORT=8000
HTTPS_PORT=8443
TZ=UTC

# Pinned images (docker-jitsi-meet release); "unstable" follows Jitsi's
# development.
JITSI_IMAGE_VERSION=stable-11248

# Internal XMPP accounts of the focus and the bridge (openssl rand -hex 16).
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=

# Address the bridge announces in its ICE candidates; set the host's LAN
# address if the tool runs on another machine.
#JVB_ADVERTISE_IPS=192.168.1.10

# --- Choose at most one of the two blocks below, then docker compose up -d.

# Secure domain with guests (US5: guests wait for a host). Create a host
# account after start:
#   docker compose exec prosody prosodyctl --config /config/prosody.cfg.lua register host meet.jitsi secret
#ENABLE_AUTH=1
#AUTH_TYPE=internal
#ENABLE_GUESTS=1

# Token authentication (US5: --jwt / --jwt-app-id with JITSI_APP_SECRET).
#ENABLE_AUTH=1
#AUTH_TYPE=jwt
#JWT_APP_ID=my_app
#JWT_APP_SECRET=
#ENABLE_GUESTS=0
